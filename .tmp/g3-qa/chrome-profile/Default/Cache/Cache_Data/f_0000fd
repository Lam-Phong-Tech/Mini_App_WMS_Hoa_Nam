der-radius: 999px;\n  background: rgba(255, 255, 255, 0.96);\n  box-shadow: 0 2px 7px rgba(47, 43, 61, 0.12);\n}\n\n.product-card__save.is-saved,\n.detail-template__save.is-saved {\n  color: #ffffff;\n  border-color: #7367f0;\n  background: #7367f0;\n}\n\n.detail-template__save {\n  display: inline-flex;\n  min-height: 38px;\n  align-items: center;\n  gap: 7px;\n  padding: 6px 10px;\n  color: #615b71;\n  font: inherit;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  border: 1px solid #dedce4;\n  border-radius: 8px;\n  background: #ffffff;\n}\n\n.library-heading {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.library-heading h2 {\n  margin: 3px 0 0;\n  color: #3e394d;\n  font-size: 21px;\n  line-height: 1.2;\n}\n\n.library-clear {\n  min-height: 40px;\n  padding: 6px 8px;\n  color: #b23b3b;\n  font: inherit;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  border: 0;\n  background: transparent;\n}\n\n.library-storage-note {\n  display: flex;\n  align-items: flex-start;\n  gap: 7px;\n  margin: 0;\n  padding: 10px 12px;\n  color: #777185;\n  font-size: 12px;\n  line-height: 1.45;\n  border: 1px solid #e1dfe6;\n  border-radius: 10px;\n  background: #faf9ff;\n}"
