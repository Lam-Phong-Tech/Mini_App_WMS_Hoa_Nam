e public\n   request: there is no basket, order, stock count, CRM assignment or status. */\n.product-detail-template {\n  padding-bottom: calc(168px + var(--hn-safe-bottom));\n}\n\n/* UIUX-G3 catalogue: all page scrolling remains on the surrounding ZaUI\n   .hn-page. These controls do not introduce a nested scroll controller. */\n.catalogue-toolbar > output {\n  min-width: 0;\n  margin-left: auto;\n  color: #777185;\n  font-size: 12px;\n  line-height: 1.35;\n  text-align: right;\n}\n\n.catalogue-availability-note,\n.search-pending,\n.infinite-load__error {\n  margin: -8px 2px 0;\n  color: #777185;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.search-pending {\n  color: #615b71;\n}\n\n.infinite-load__error {\n  margin: 0;\n  color: #a14c00;\n  text-align: center;\n}\n\n.category-return,\n.detail-template__more-related,\n.detail-template__linked-list button {\n  min-height: 44px;\n  color: var(--hn-primary);\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n  border: 0;\n  background: transparent;\n}\n\n.category-return {\n  justify-self: start;\n  padding: 0 4px;\n}\n\n.product-grid--virtual {\n  display: block;\n}\n\n.product-grid__virtual-spacer {\n  position: relative;\n  width: 100%;\n}\n\n.product-grid__virtual-row {\n  position: absolute;\n  left: 0;\n  display: grid;\n  width: 100%;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 16px;\n  padding-bottom: 16px;\n  will-change: transform;\n}\n\n.detail-template__variants {\n  display: grid;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.detail-template__variants > span {\n  color: #777185;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.detail-template__variants > div {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.detail-template__variants button {\n  min-height: 40px;\n  padding: 7px 10px;\n  color: #3e394d;\n  font: inherit;\n  font-size: 13px;\n  cursor: pointer;\n  border: 1px solid #dcd9e3;\n  border-radius: 8px;\n  background: #ffffff;\n}\n\n.detail-template__variants butto