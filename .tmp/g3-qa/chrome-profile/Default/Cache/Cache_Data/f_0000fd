areas ------------------------------------------------------------\n   `viewport-fit=cover` is declared in index.html. These fallback insets keep\n   the app clear of Android status/notch areas in embedded WebViews (where env\n   can be zero), while iPhones automatically use the larger Dynamic Island/\n   Face ID inset supplied by Safari/Zalo. */\n:root {\n  --hn-safe-top: max(24px, env(safe-area-inset-top, 0px));\n  --hn-safe-bottom: max(8px, env(safe-area-inset-bottom, 0px));\n}\n\n.hn-header.app-header {\n  height: calc(56px + var(--hn-safe-top));\n  min-height: calc(56px + var(--hn-safe-top));\n  flex-basis: calc(56px + var(--hn-safe-top));\n  padding-top: var(--hn-safe-top);\n}\n\n.hn-header.app-header.app-header--home {\n  height: calc(70px + var(--hn-safe-top));\n  min-height: calc(70px + var(--hn-safe-top));\n  flex-basis: calc(70px + var(--hn-safe-top));\n}\n\n.hn-content.app-content {\n  padding-bottom: calc(78px + var(--hn-safe-bottom));\n}\n\n.hn-content.app-content--home {\n  padding-bottom: calc(82px + var(--hn-safe-bottom));\n}\n\n.hn-bottom-navigation {\n  height: calc(60px + var(--hn-safe-bottom));\n  min-height: calc(60px + var(--hn-safe-bottom));\n  padding-bottom: var(--hn-safe-bottom);\n}\n\n.product-detail-template {\n  padding-bottom: calc(88px + var(--hn-safe-bottom));\n}\n\n.detail-template__contact-actions {\n  padding-bottom: calc(12px + var(--hn-safe-bottom));\n}\n\n/* Search suggestions: show the complete public product preview as a compact\n   result list before the customer types, rather than an empty instruction card. */\n.search-entry--page {\n  min-height: 56px;\n  gap: 12px;\n  padding: 0 14px;\n  border-color: #8a7eff;\n  border-radius: 12px;\n  box-shadow: 0 0 0 2px rgba(115, 103, 240, 0.12);\n}\n\n.search-entry--page > svg {\n  flex: 0 0 23px;\n  color: #615b71;\n}\n\n.search-entry--page input {\n  min-height: 50px;\n  font-size: 14px;\n}\n\n.search-suggestion-results {\n  display: grid;\n  gap: 10px;\n}\n\n.search-suggestion-re