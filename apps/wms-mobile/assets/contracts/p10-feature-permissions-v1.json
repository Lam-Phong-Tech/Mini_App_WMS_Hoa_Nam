  "evaluation": {
    "permissions": "Every allOf key AND (at least one anyOf key when anyOf is nonempty). Empty anyOf adds no condition. Never OR the allOf and anyOf buckets.",
    "route_middleware": "Exact permission middleware only; other registered auth/scope/validation middleware still applies. Multiple middleware entries are AND; pipes within one entry are OR.",
    "permission_semantics": {
      "OWNER_HAS_PERMISSION": "Existing User::hasPermission and CheckPermission behavior, including SUPER_ADMIN bypass. /auth/me data.permissions uses User::permissionCodes: SUPER_ADMIN expands the ACTIVE permission catalog. This is a legacy projection, not proof of persisted scoped grants.",
      "ACTIVE_SCOPED_GRANTS": "Fresh ACTIVE actor; active effective role assignments with scope_ref null/empty or the requested warehouse; ACTIVE permission rows from those roles plus ACTIVE direct user_permission rows. No role-code bypass. Direct grants still require separate warehouse/context checks. P18 and numbered P05 owners use this model."
    },
    "owner_decision": "Matching keys is only a permission prerequisite. Every action requires the current backend owner to validate scope, session, state, version, receipts and capabilities. The contract never returns per-user authorization or group ticks.",
    "app_ui_boundary": "A mapped POST, EXPORT or other mutation documents an existing backend route only. It does not declare a mobile/App action visible, enabled, approved or permitted in the UI. App workflow availability and BA acceptance are separate; in particular, backend POST endpoints do not approve mobile posting controls.",
    "live_changes": "Revalidate on every action and exact receipt/readback. Refresh context after revoke, context switch or capability changes; do not reuse a profile ETag as an authorization version.",
    "numbered_p05": "Use ACTIVE_SCOPED_GRANTS for the numbering header and already-reserved OUTBOUND drafts, including read/cancel/reconcile/record without the header. Legacy /me expansion is insufficient; source-linked mode retains its source number and owner rules.",
    "record_vs_post": "Inbound/outbound RECORD is not POST and does not imply inbound.post/outbound.post. Component issue RECORD is a different owner that can post stock atomically. No action is inherited from a group VIEW key.",
    "tenant": "Use only trusted owner dimensions. P09/P12/P18 compare actor and warehouse tenant_id/org_id/organization_id where present and isolate sources. Other legacy owners retain their existing scope; this mapping does not invent a tenant guarantee."
  },
